---
import '../styles/tokens.css';
import { en } from '../i18n/en';
import { optionalUser } from '../lib/session';

interface Props {
  title: string;
  description?: string;
  image?: string;
  robots?: string;
  sessionAware?: boolean;
}

const {
  title,
  description = en.seo.descriptions[Astro.url.pathname as keyof typeof en.seo.descriptions] ?? en.seo.defaultDescription,
  image = '/social-card.jpg',
  robots = 'index, follow',
  sessionAware = true,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.url.origin).toString();
const socialImage = new URL(image, Astro.url.origin).toString();
// Session-aware nav (server-side, zero client JS): logged-in users see
// Dashboard + Log out instead of WCA Login. Null-safe on static routes.
const session = sessionAware ? await optionalUser(Astro.request, Astro.locals).catch(() => null) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Speedcubing Bangladesh" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Speedcubing Bangladesh`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A speed cube in motion in the Speedcubing Bangladesh color palette" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Speedcubing Bangladesh`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title} — Speedcubing Bangladesh</title>
  </head>
  <body class="bg-paper font-display text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>

    <header class="relative border-b-2 border-ink bg-white">
      <div class="container-x flex items-center justify-between gap-4 py-3">
        <a href="/" class="leading-tight">
          <span class="block text-lg font-extrabold tracking-tight">{en.brand.name}</span>
          <span class="data-font block text-[11px] font-bold uppercase tracking-[0.08em] text-emerald-brand">
            {en.brand.status}
          </span>
        </a>
        <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
          {
            en.nav.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href || path.startsWith(item.href + '/') ? 'page' : undefined}
                class="text-sm font-semibold hover:text-emerald-brand"
              >
                {item.label}
              </a>
            ))
          }
          {session ? (
            <>
              <a
                href="/dashboard"
                aria-current={path === '/dashboard' || path.startsWith('/dashboard/') ? 'page' : undefined}
                class="btn-pill border-2 border-ink bg-emerald-brand px-4 py-2 text-sm text-white shadow-brutal"
              >
                Dashboard
              </a>
              <a href="/api/auth/logout" class="text-sm font-semibold hover:text-emerald-brand">
                Log Out
              </a>
            </>
          ) : (
            <a href={en.auth.loginHref} class="btn-pill border-2 border-ink bg-speed-orange px-4 py-2 text-sm text-white shadow-brutal">
              {en.auth.login}
            </a>
          )}
        </nav>
        <details class="md:hidden">
          <summary class="btn-pill cursor-pointer list-none border-2 border-ink bg-white px-4 py-2 text-sm [&::-webkit-details-marker]:hidden" aria-label="Open menu">
            Menu
          </summary>
          <nav class="absolute inset-x-0 top-full z-50 flex flex-col gap-1 border-b-2 border-ink bg-white p-4" aria-label="Mobile">
            {
              en.nav.map((item) => (
                <a href={item.href} aria-current={path === item.href || path.startsWith(item.href + '/') ? 'page' : undefined} class="rounded-lg px-3 py-2 text-base font-semibold hover:bg-paper">
                  {item.label}
                </a>
              ))
            }
            {session ? (
              <>
                <a href="/dashboard" class="btn-pill mt-2 border-2 border-ink bg-emerald-brand px-4 py-2 text-center text-white">
                  Dashboard
                </a>
                <a href="/api/auth/logout" class="rounded-lg px-3 py-2 text-base font-semibold hover:bg-paper">
                  Log Out
                </a>
              </>
            ) : (
              <a href={en.auth.loginHref} class="btn-pill mt-2 border-2 border-ink bg-speed-orange px-4 py-2 text-center text-white">
                {en.auth.login}
              </a>
            )}
          </nav>
        </details>
      </div>
      <!-- TODO WP-13/A7: pinned announcement bar renders here when set in D1. -->
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-16 bg-ink text-white">
      <div class="container-x py-10">
        <p class="text-xl font-extrabold tracking-tight">{en.brand.name}</p>
        <p class="data-font mt-1 text-[11px] font-bold uppercase tracking-[0.08em] text-cube-yellow">
          {en.brand.status}
        </p>
        <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
          {
            en.footer.links.map((item) =>
              'external' in item && item.external ? (
                <a href={item.href} target="_blank" rel="noopener" class="text-sm text-white/80 hover:text-white">
                  {item.label}
                </a>
              ) : (
                <a href={item.href} class="text-sm text-white/80 hover:text-white">
                  {item.label}
                </a>
              ),
            )
          }
        </nav>
        {en.footer.socials.some((s) => s.href !== '#') && (
          <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2" aria-label="Social">
            {en.footer.socials
              .filter((s) => s.href !== '#')
              .map((s) => (
                <a href={s.href} target="_blank" rel="noopener" class="text-sm font-bold text-white/80 underline hover:text-white">
                  {s.label}
                </a>
              ))}
          </nav>
        )}
        <p class="mt-6 text-xs text-white/60">{en.footer.legal}</p>
      </div>
    </footer>
  </body>
</html>
