---
import Base from '../../layouts/Base.astro';
import ContentBody from '../../components/ContentBody.astro';
import { countRegistrations, getCompOverride } from '../../lib/content';
import { getCompRoster, getMyRegistrations } from '../../lib/registrations';
import { optionalUser } from '../../lib/session';
import { EDGE_CACHE_VALUE, tryLoad } from '../../lib/page';
import { getCompetition, venueDisplay } from '../../lib/wca';

export const prerender = false;
Astro.response.headers.set('Cache-Control', EDGE_CACHE_VALUE);

const { slug } = Astro.params;
const detail = await tryLoad(
  Astro.locals,
  (env) => getCompetition(env, slug ?? ''),
  { data: null, asOfExportDate: null, stale: true },
);
const comp = detail.data;
if (!comp && slug) {
  // Unknown locally — the canonical page always exists on WCA.
  return Astro.redirect(`https://www.worldcubeassociation.org/competitions/${slug}`, 302);
}
if (!comp) return new Response('Not found', { status: 404 });

const override = await tryLoad(Astro.locals, (env) => getCompOverride(env, comp.wca_id), null);
const siteRegs = await tryLoad(Astro.locals, (env) => countRegistrations(env, comp.wca_id), 0);
const roster = await tryLoad(Astro.locals, (env) => getCompRoster(env, comp.wca_id), []);
// Server-side roster search (no client JS): ?search= matches name or WCA ID.
const search = (Astro.url.searchParams.get('search') ?? '').trim().toLowerCase();
const shownRoster = search
  ? roster.filter((r) => `${r.name} ${r.wca_id ?? ''}`.toLowerCase().includes(search))
  : roster;

let feeTiers: Record<string, unknown> = {};
try {
  if (override?.fee_tiers_json) feeTiers = JSON.parse(override.fee_tiers_json) as Record<string, unknown>;
} catch {
  feeTiers = {};
}
const wallets = {
  bkash: typeof feeTiers.bkash_wallet === 'string' ? feeTiers.bkash_wallet : null,
  nagad: typeof feeTiers.nagad_wallet === 'string' ? feeTiers.nagad_wallet : null,
};
const fees = Object.entries(feeTiers).filter(([k]) => !['bkash_wallet', 'nagad_wallet'].includes(k));
// Registration state: past comps are closed (honest dead-end removal); open
// comps register inline when logged in, or bounce through WCA login with ?next=.
const todayStamp = new Date().toISOString().slice(0, 10);
const regOpen = comp.end_date >= todayStamp;
const session = await optionalUser(Astro.request, Astro.locals).catch(() => null);
let myReg: null | Awaited<ReturnType<typeof getMyRegistrations>>[number] = null;
if (session) {
  const mine = await tryLoad(Astro.locals, (env) => getMyRegistrations(env, session.cid), []);
  myReg = mine.find((r) => r.comp_wca_id === comp.wca_id) ?? null;
}
const offeredEvents = comp.event_detail.length > 0 ? comp.event_detail.map((e) => e.event) : comp.events;
function maskWallet(w: string): string {
  const s = w.trim();
  if (s.length <= 5) return '•••••';
  return `${s.slice(0, 3)}••••${s.slice(-2)}`;
}
---

<Base title={comp.name}>
  <section class="container-x max-w-4xl py-12">
    <a href="/competitions" class="text-sm font-semibold text-emerald-brand underline">← Competitions</a>
    <p class="data-font mt-3 inline-block rounded-full border-2 border-ink bg-white px-3 py-1 text-xs font-bold uppercase tracking-wider">
      Official WCA competition
    </p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight">{comp.name}</h1>
    <p class="data-font mt-2 break-words text-slate-600">
      {comp.start_date} → {comp.end_date} •{' '}
      {(() => {
        const v = venueDisplay(comp.venue);
        return v.url ? (
          <a class="underline" href={v.url} target="_blank" rel="noopener">{v.name}</a>
        ) : (
          v.name
        );
      })()}
      , {comp.city}
    </p>
    <p class="mt-1 text-sm text-slate-600">
      {comp.address} • Cap: {comp.competitor_limit ?? 'TBA'}
      {comp.competitor_limit ? ` (${siteRegs} registered on this site)` : ''}
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      {regOpen ? (
        <a href="#register" class="btn-pill border-2 border-ink bg-speed-orange px-6 py-2 text-white shadow-brutal">
          Register &amp; Submit Payment
        </a>
      ) : (
        <span class="btn-pill inline-block border-2 border-ink bg-white px-6 py-2 text-slate-500">
          Registration closed — this event ended {comp.end_date}
        </span>
      )}
      <a href={comp.url} target="_blank" rel="noopener" class="btn-pill border-2 border-ink bg-white px-6 py-2 shadow-brutal">
        Official WCA Page
      </a>
      {
        comp.live_url && (
          <a href={comp.live_url} target="_blank" rel="noopener" class="btn-pill border-2 border-ink bg-white px-6 py-2 shadow-brutal">
            Live Results
          </a>
        )
      }
    </div>

    <div class="card-brutal mt-8 p-6">
      <h2 class="text-2xl font-extrabold">Sanctioned events</h2>
      <p class="mt-2 text-sm">{comp.events.join(' • ') || 'See the WCA page for the event list.'}</p>
      {
        comp.event_detail.length > 0 && (
          <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-150 text-left text-sm">
              <thead>
                <tr class="border-b-2 border-ink">
                  <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">Event</th>
                  <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">Rounds</th>
                  <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">Format</th>
                  <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">Limit</th>
                  <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">Cutoff</th>
                </tr>
              </thead>
              <tbody>
                {comp.event_detail.map((e) => (
                  <tr class="border-b border-slate-200 last:border-0">
                    <td class="px-3 py-2 font-bold">{e.event}</td>
                    <td class="data-font px-3 py-2">{e.rounds}</td>
                    <td class="px-3 py-2">{e.format}</td>
                    <td class="data-font px-3 py-2">{e.time_limit_centis !== null ? `${(e.time_limit_centis / 100).toFixed(2)}s` : '—'}</td>
                    <td class="data-font px-3 py-2">{e.cutoff_centis !== null ? `${(e.cutoff_centis / 100).toFixed(2)}s` : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    {(comp.schedule ?? []).length > 0 && (
      <div class="card-brutal mt-6 p-6">
        <h2 class="text-2xl font-extrabold">Schedule</h2>
        <p class="data-font mt-1 text-xs uppercase tracking-wider text-slate-500">Venue time (Asia/Dhaka)</p>
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          {(comp.schedule ?? []).map((day, di) => (
            <details class="rounded-xl border-2 border-ink p-4" open={di === 0}>
              <summary class="cursor-pointer font-extrabold">{day.label}</summary>
              <ol class="mt-2 flex flex-col gap-1 text-sm">
                {day.items.map((it) => (
                  <li class="flex gap-2">
                    <span class="data-font shrink-0 font-bold">
                      {it.start}–{it.end}
                    </span>
                    <span>
                      {it.title}
                      {it.room && <span class="text-slate-500"> • {it.room}</span>}
                    </span>
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      </div>
    )}

    {(comp.delegates ?? []).length > 0 && (
      <div class="card-brutal mt-6 p-6">
        <h2 class="text-2xl font-extrabold">WCA delegates</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {(comp.delegates ?? []).map((d) => (
            <div class="flex items-center justify-between gap-2 rounded-xl border-2 border-ink p-4">
              <div>
                <p class="font-extrabold">{d.name}</p>
                {d.wca_id && (
                  <a class="data-font text-xs text-slate-600 underline" href={`https://www.worldcubeassociation.org/persons/${d.wca_id}`} target="_blank" rel="noopener">
                    {d.wca_id}
                  </a>
                )}
              </div>
              <span class={`data-font shrink-0 rounded-full border border-ink px-2 py-0.5 text-xs font-bold uppercase ${d.role === 'delegate' ? 'bg-emerald-brand text-white' : 'bg-white'}`}>
                {d.role === 'delegate' ? 'Verified' : 'Organizer'}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}

    {
      (fees.length > 0 || wallets.bkash || wallets.nagad || override?.venue_note || regOpen) && (
        <div class="card-brutal mt-6 p-6" id="register">
          <h2 class="text-2xl font-extrabold">Registration &amp; payment</h2>
          {fees.length > 0 && (
            <dl class="mt-3 flex flex-wrap gap-4">
              {fees.map(([k, v]) => (
                <div>
                  <dt class="data-font text-xs uppercase tracking-wider text-slate-500">{k}</dt>
                  <dd class="data-font text-xl font-bold">৳{String(v)}</dd>
                </div>
              ))}
            </dl>
          )}
          {(wallets.bkash || wallets.nagad) && (
            <div class="mt-3 flex flex-col gap-1 text-sm">
              {wallets.bkash && (
                <details class="data-font">
                  <summary class="cursor-pointer underline">bKash: {maskWallet(wallets.bkash)} — Reveal</summary>
                  <p class="mt-1">{wallets.bkash}</p>
                </details>
              )}
              {wallets.nagad && (
                <details class="data-font">
                  <summary class="cursor-pointer underline">Nagad: {maskWallet(wallets.nagad)} — Reveal</summary>
                  <p class="mt-1">{wallets.nagad}</p>
                </details>
              )}
              <p class="text-xs text-slate-500">Send Money, then submit the TxID from your dashboard. Whole taka only.</p>
            </div>
          )}
          {override?.venue_note && <p class="mt-3 text-sm">{override.venue_note}</p>}
          {override?.payment_steps_json && (
            <div class="prose mt-3 max-w-none text-sm">
              <ContentBody docJson={override.payment_steps_json} />
            </div>
          )}
          {!regOpen ? (
            <p class="mt-4 rounded-lg border-2 border-ink bg-paper p-4 text-sm">
              Registration for this competition is closed — it ended {comp.end_date}. Results live on the{' '}
              <a class="font-bold text-emerald-brand underline" href={comp.url} target="_blank" rel="noopener">Official WCA Page</a>.
            </p>
          ) : !session ? (
            <p class="mt-4 rounded-lg border-2 border-ink bg-paper p-4 text-sm">
              <a class="font-bold text-emerald-brand underline" href={`/api/auth/login?next=/competitions/${comp.wca_id}`}>
                Log in with WCA
              </a>{' '}
              to register for this competition — you'll return here after login.
            </p>
          ) : !myReg ? (
            <form data-register-form={comp.wca_id} class="mt-4 rounded-lg border-2 border-ink bg-paper p-4">
              <p class="text-sm font-bold">Step 1 — choose your events</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {offeredEvents.map((e) => (
                  <label class="data-font flex items-center gap-1 rounded-lg border-2 border-ink bg-white px-3 py-1 text-sm font-bold">
                    <input name="events" value={e} type="checkbox" class="h-4 w-4 accent-emerald-brand" /> {e}
                  </label>
                ))}
              </div>
              <p data-form-msg class="mt-2 hidden text-sm font-semibold"></p>
              <button type="submit" class="btn-pill mt-3 border-2 border-ink bg-emerald-brand px-6 py-2 text-white shadow-brutal">
                Register (pending)
              </button>
            </form>
          ) : myReg.status === 'verified' ? (
            <p class="data-font mt-4 rounded-lg border-2 border-ink bg-emerald-brand p-4 text-sm font-bold text-white">
              ✅ Fee verified{myReg.wca_accepted === 1 ? ' • Accepted on WCA' : ' • WCA acceptance pending'} —{' '}
              <a class="underline" href={`/dashboard/registrations/${myReg.id}/slip`}>print your slip</a>
            </p>
          ) : (
            <form data-tx-form={myReg.id} class="mt-4 rounded-lg border-2 border-ink bg-paper p-4">
              <p class="text-sm font-bold">
                Step 2 — submit your payment {myReg.latest_tx ? `(latest: ${myReg.latest_tx.txn_id} • ${myReg.latest_tx.status})` : ''}
              </p>
              <p class="mt-1 text-xs text-slate-500">Send Money first, then submit the TxID. Whole taka only.</p>
              <div class="mt-2 grid gap-2 sm:grid-cols-3">
                <label class="flex flex-col gap-1 text-sm font-bold">
                  Sender number
                  <input name="sender_number" type="text" required maxlength="32" placeholder="+8801…" class="rounded-lg border-2 border-ink px-3 py-2 font-normal" />
                </label>
                <label class="flex flex-col gap-1 text-sm font-bold">
                  TxID
                  <input name="txn_id" type="text" required maxlength="20" placeholder="e.g. 9M88A72B4K" class="data-font rounded-lg border-2 border-ink px-3 py-2 font-normal" />
                </label>
                <label class="flex flex-col gap-1 text-sm font-bold">
                  Amount (৳)
                  <input name="amount_bdt" type="number" required min="1" step="1" placeholder="850" class="data-font rounded-lg border-2 border-ink px-3 py-2 font-normal" />
                </label>
              </div>
              <p data-form-msg class="mt-2 hidden text-sm font-semibold"></p>
              <button type="submit" class="btn-pill mt-3 border-2 border-ink bg-speed-orange px-6 py-2 text-white shadow-brutal">
                Submit TxID for review
              </button>
            </form>
          )}
        </div>
      )
    }

<script>
  document.querySelectorAll('[data-register-form]').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector('[data-form-msg]') as HTMLElement;
      msg.classList.remove('hidden');
      try {
        const data = new FormData(form);
        const events = data.getAll('events').map(String);
        const res = await fetch('/api/registrations', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ comp_wca_id: form.dataset.registerForm, events }),
        });
        const body = (await res.json()) as { error?: string };
        if (!res.ok) throw new Error(body.error || 'registration failed');
        window.location.reload();
      } catch (err) {
        msg.textContent = err instanceof Error ? err.message : 'registration failed';
        msg.classList.add('text-red-700');
      }
    });
  });
  document.querySelectorAll('[data-tx-form]').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector('[data-form-msg]') as HTMLElement;
      msg.classList.remove('hidden');
      try {
        const data = new FormData(form);
        const res = await fetch('/api/tx', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            registration_id: form.dataset.txForm,
            sender_number: String(data.get('sender_number') ?? ''),
            txn_id: String(data.get('txn_id') ?? ''),
            amount_bdt: Number(data.get('amount_bdt')),
          }),
        });
        const body = (await res.json()) as { error?: string };
        if (!res.ok) throw new Error(body.error || 'submit failed');
        msg.textContent = 'TxID received — track it in your dashboard.';
        msg.classList.add('text-emerald-brand');
        form.reset();
      } catch (err) {
        msg.textContent = err instanceof Error ? err.message : 'submit failed';
        msg.classList.add('text-red-700');
      }
    });
  });
</script>

    <div class="card-brutal mt-6 p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-extrabold">Site registrations roster</h2>
        {comp.competitor_limit ? (
          <p class="data-font text-sm text-slate-600">
            {siteRegs} of {comp.competitor_limit} site slots
          </p>
        ) : (
          <p class="data-font text-sm text-slate-600">{siteRegs} on this site</p>
        )}
      </div>
      <form method="get" class="mt-3 flex max-w-md gap-2">
        <input
          name="search"
          type="search"
          value={Astro.url.searchParams.get('search') ?? ''}
          placeholder="Search by name or WCA ID…"
          maxlength="60"
          class="min-w-0 flex-1 rounded-lg border-2 border-ink px-3 py-2 text-sm"
        />
        <button type="submit" class="btn-pill shrink-0 border-2 border-ink bg-white px-4 py-2 text-sm shadow-brutal">
          Search
        </button>
      </form>
      {shownRoster.length === 0 ? (
        <p class="mt-3 text-sm text-slate-600">
          {roster.length === 0 ? 'No site registrations yet — be the first.' : `No registrations match “${search}”.`}
        </p>
      ) : (
        <>
        <p class="data-font mt-3 text-xs text-slate-400 sm:hidden">Swipe sideways for more columns →</p>
        <div class="mt-1 overflow-x-auto">
          <table class="w-full min-w-150 text-left text-sm">
            <thead>
              <tr class="border-b-2 border-ink">
                <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">Site reg #</th>
                <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">Competitor</th>
                <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">Fee</th>
                <th class="data-font px-3 py-2 text-xs uppercase tracking-wider text-slate-500">WCA</th>
              </tr>
            </thead>
            <tbody>
              {shownRoster.map((r) => (
                <tr class="border-b border-slate-200 last:border-0">
                  <td class="data-font px-3 py-2">{r.siteRegNo}</td>
                  <td class="px-3 py-2 font-bold">
                    {r.wca_id ? (
                      <a class="underline" href={`https://www.worldcubeassociation.org/persons/${r.wca_id}`} target="_blank" rel="noopener">
                        {r.name}
                      </a>
                    ) : (
                      r.name
                    )}
                  </td>
                  <td class="px-3 py-2">{r.fee === 'verified' ? '✅ Verified' : r.fee === 'pending' ? '⏳ Under review' : '⬜ Not submitted'}</td>
                  <td class="px-3 py-2">{r.wcaAccepted ? '✅ Accepted' : '⬜ Pending'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        </>
      )}
    </div>

    <p class="mt-6 max-w-3xl text-xs text-slate-500">
      WCA ID validation required. Acceptance on WCA is finalized manually by delegates after fee verification.
      Registration counts above cover this site only — the WCA roster is canonical.
    </p>
  </section>
</Base>
