---
import Base from '../layouts/Base.astro';

export const prerender = true;
---

<Base title="Page not found" robots="noindex, nofollow" sessionAware={false}>
  <section class="container-x py-16">
    <div class="card-brutal shadow-brutal max-w-xl p-8">
      <h1 class="text-3xl font-extrabold tracking-tight">404 — Lost cube?</h1>
      <p class="mt-3 text-slate-600">
        This page doesn't exist. Try the <a class="font-semibold text-emerald-brand underline" href="/competitions">competitions</a> or
        <a class="font-semibold text-emerald-brand underline" href="/lost-found">lost &amp; found</a>.
      </p>
    </div>
  </section>
</Base>
