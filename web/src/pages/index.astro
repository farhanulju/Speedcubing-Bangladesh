---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { en } from '../i18n/en';
import { getDonationPage, getNews, getPinnedAnnouncements, getSponsors } from '../lib/content';
import { EDGE_CACHE_VALUE, tryLoad } from '../lib/page';
import { eventName, formatRecordValue, getCompetitions, getRecords, venueDisplay } from '../lib/wca';

// Server-rendered with edge caching (Cloudflare has no Next-style ISR:
// s-maxage below is the equivalent). Never prerendered — data comes from
// KV/D1 at request time, unavailable at build.
export const prerender = false;
Astro.response.headers.set('Cache-Control', EDGE_CACHE_VALUE);

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const ann = await tryLoad(Astro.locals, (env) => getPinnedAnnouncements(env), []);
const comps = await tryLoad(Astro.locals, (env) => getCompetitions(env), {
  data: null,
  asOfExportDate: null,
  stale: true,
});
const recs = await tryLoad(Astro.locals, (env) => getRecords(env), {
  data: null,
  asOfExportDate: null,
  stale: true,
});
const sponsors = await tryLoad(Astro.locals, (env) => getSponsors(env), []);
const news = await tryLoad(Astro.locals, (env) => getNews(env, 3), []);
const donation = await tryLoad(Astro.locals, (env) => getDonationPage(env), null);
const todayStamp = new Date().toISOString().slice(0, 10);
const compItems = comps?.data?.items ?? [];
const upcoming = compItems.filter((c) => c.end_date >= todayStamp).slice(0, 3);
const pastHome = compItems.filter((c) => c.end_date < todayStamp).slice(0, 3);
// Next upcoming comp for the hero countdown (N14: day-precision unless <48h out).
// Renders nothing when the cache holds no future comp — never a fake number.
const nextUp = (comps?.data?.items ?? [])
  .filter((c) => c.end_date >= new Date().toISOString().slice(0, 10))
  .sort((a, b) => (a.start_date < b.start_date ? -1 : 1))[0];
let countdown: string | null = null;
if (nextUp) {
  const ms = new Date(`${nextUp.start_date}T00:00:00+06:00`).getTime() - Date.now();
  if (ms <= 0) countdown = 'Happening now';
  else if (ms < 48 * 3600 * 1000) countdown = `Starts in ${Math.floor(ms / 3600000)}h ${Math.floor((ms % 3600000) / 60000)}m`;
  else countdown = `Starts in ${Math.ceil(ms / 86400000)} days`;
}
const spotlight = recs?.data?.records.slice(0, 3) ?? [];
const pct = donation && donation.target_bdt > 0 ? Math.min(100, Math.round((donation.raised_manual_bdt / donation.target_bdt) * 100)) : 0;
---

<Base title="Home">
  {
    (() => {
      const first = ann[0];
      return (
        first && (
          <div class="border-b-2 border-ink bg-cube-yellow">
            <div class="container-x flex flex-wrap items-center gap-2 py-2 text-sm font-bold">
              <span class="data-font rounded-full border border-ink bg-white px-2 py-0.5 text-xs">NEW</span>
              {first.title}
            </div>
          </div>
        )
      );
    })()
  }

  <section class="container-x py-12">
    <p class="data-font inline-block rounded-full border-2 border-ink bg-white px-3 py-1 text-xs font-bold uppercase tracking-wider">
      {en.home.badge}
    </p>
    <h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight md:text-5xl">{en.home.headline}</h1>
    <p class="mt-3 max-w-2xl text-lg text-slate-600">{en.home.sub}</p>
    {nextUp && countdown && (
      <p class="mt-3">
        <a href={`/competitions/${nextUp.wca_id}`} class="data-font inline-block rounded-full border-2 border-ink bg-cube-yellow px-4 py-1 text-sm font-bold">
          Next up: {nextUp.name} — {countdown}
        </a>
      </p>
    )}
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/competitions" class="btn-pill border-2 border-ink bg-speed-orange px-6 py-2 text-white shadow-brutal">
        {en.home.ctaComps}
      </a>
      <a href="/about" class="btn-pill border-2 border-ink bg-white px-6 py-2 shadow-brutal">
        {en.home.ctaAbout}
      </a>
    </div>
  </section>

  <section class="container-x py-8">
    <div class="flex items-baseline justify-between">
      <h2 class="text-2xl font-extrabold tracking-tight">{en.home.compsTitle}</h2>
      <a href="/competitions" class="shrink-0 text-sm font-bold text-emerald-brand underline">Full calendar</a>
    </div>
    {
      upcoming.length === 0 ? (
        <p class="mt-4 text-slate-600">
          No upcoming competitions in the cache right now.{' '}
          <a class="font-bold text-emerald-brand underline" href="/competitions">Browse the archive</a> or check the WCA calendar.
        </p>
      ) : (
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {upcoming.map((c) => (
            <article class="card-brutal shadow-brutal min-w-0 p-5 hover:-translate-y-0.5">
              <p class="data-font text-xs font-bold uppercase tracking-wider text-speed-orange">{c.city}</p>
              <h3 class="mt-1 text-lg font-extrabold"><a class="underline decoration-transparent hover:decoration-current" href={`/competitions/${c.wca_id}`}>{c.name}</a></h3>
              <p class="data-font mt-1 text-sm text-slate-600">
                {c.start_date} → {c.end_date}
              </p>
              <p class="mt-1 break-words text-sm text-slate-600">
                {(() => {
                  const v = venueDisplay(c.venue);
                  return v.url ? (
                    <a class="underline" href={v.url} target="_blank" rel="noopener">{v.name}</a>
                  ) : (
                    v.name
                  );
                })()}
              </p>
            </article>
          ))}
        </div>
      )
    }
    {pastHome.length > 0 && (
      <>
        <h3 class="data-font mt-6 text-sm font-bold uppercase tracking-wider text-slate-500">
          {upcoming.length > 0 ? 'Recently held' : 'Recent competitions'}
        </h3>
        <div class="mt-3 grid gap-4 md:grid-cols-3">
          {pastHome.map((c) => (
            <a href={`/competitions/${c.wca_id}`} class="card-brutal block min-w-0 p-5 hover:-translate-y-0.5">
              <p class="data-font flex items-center justify-between gap-2 text-xs font-bold uppercase tracking-wider">
                <span class="text-slate-500">{c.city}</span>
                <span class="rounded-full border border-ink bg-white px-2 py-0.5">Past</span>
              </p>
              <p class="mt-1 text-lg font-extrabold">{c.name}</p>
              <p class="data-font mt-1 text-sm text-slate-600">
                {c.start_date} → {c.end_date}
              </p>
            </a>
          ))}
        </div>
      </>
    )}
  </section>

  <section class="container-x py-8">
    <div class="flex items-baseline justify-between">
      <h2 class="text-2xl font-extrabold tracking-tight">{en.home.recordsTitle}</h2>
      <a href="/records" class="shrink-0 text-sm font-bold text-emerald-brand underline">All records</a>
    </div>
    {
      spotlight.length === 0 ? (
        <p class="mt-4 text-slate-600">Records sync daily from the WCA export.</p>
      ) : (
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {spotlight.map((r) => (
            <a href={`/records?event=${encodeURIComponent(r.event)}`} class="card-brutal block p-5 hover:-translate-y-0.5">
              <p class="flex flex-wrap items-center gap-2 font-extrabold">
                {r.event_name || eventName(r.event)}
                <span class="data-font rounded border border-ink bg-cube-yellow px-1.5 py-0.5 text-[10px] font-bold">{r.event}</span>
              </p>
              {r.single && (
                <p class="data-font mt-1 text-2xl font-bold">
                  {formatRecordValue(r.event, 'single', r.single.value_centis) ?? '—'} <span class="text-xs font-normal">single • {r.single.holder}</span>
                </p>
              )}
            </a>
          ))}
        </div>
      )
    }
  </section>

  {
    donation && (
      <section class="container-x py-8">
        <div class="card-brutal shadow-brutal bg-electric-violet p-6 text-white">
          <h2 class="text-2xl font-extrabold">{en.home.worldsTitle}</h2>
          <p class="data-font mt-2 text-sm">
            Raised ৳{donation.raised_manual_bdt} of ৳{donation.target_bdt} ({pct}%)
          </p>
          <div class="mt-2 h-3 overflow-hidden rounded-full border border-white/40 bg-black/30">
            <div class="h-full bg-cube-yellow" style={`width:${pct}%`} />
          </div>
          <a href="/worlds-2027" class="btn-pill mt-4 inline-block border-2 border-ink bg-speed-orange px-6 py-2 text-white">
            Support Team Bangladesh
          </a>
          <a href="/sponsors" class="btn-pill mt-4 inline-block border-2 border-ink bg-white px-6 py-2 text-ink">
            Sponsorship Details
          </a>
        </div>
      </section>
    )
  }

  {
    sponsors.length > 0 && (
      <section class="container-x py-8">
        <h2 class="text-2xl font-extrabold tracking-tight">Sponsors</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          {sponsors.map((s) => (
            <span class="card-brutal px-4 py-2 font-bold">{s.name}</span>
          ))}
        </div>
      </section>
    )
  }

  {
    news.length > 0 && (
      <section class="container-x py-8">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-extrabold tracking-tight">Latest news</h2>
          <a href="/news" class="shrink-0 text-sm font-bold text-emerald-brand underline">All news</a>
        </div>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {news.map((n) => (
            <a href={`/news/${n.slug}`} class="card-brutal block p-5 hover:-translate-y-0.5">
              <p class="font-extrabold">{n.title}</p>
              <p class="data-font mt-1 text-xs text-slate-500">{n.published_at ?? ''}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="container-x py-8">
    <h2 class="text-2xl font-extrabold tracking-tight">Sign up for alerts</h2>
    <div class="mt-4 max-w-xl">
      <NewsletterForm siteKey={siteKey} />
    </div>
  </section>
</Base>
