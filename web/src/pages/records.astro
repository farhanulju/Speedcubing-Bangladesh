---
import Base from '../layouts/Base.astro';
import { getRecordSnapshots } from '../lib/content';
import type { RecordSnapshot } from '../lib/content';
import { EDGE_CACHE_VALUE, tryLoad } from '../lib/page';
import { formatRecordValue, getRecords } from '../lib/wca';

export const prerender = false;
Astro.response.headers.set('Cache-Control', EDGE_CACHE_VALUE);

const recs = await tryLoad(Astro.locals, (env) => getRecords(env), { data: null, asOfExportDate: null, stale: true });
const snaps = await tryLoad(Astro.locals, (env) => getRecordSnapshots(env), []);
const all = recs.data?.records ?? [];
// Server-side filter (no client JS): ?q= matches event code, name, or holder.
const q = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();
const records = q
  ? all.filter((r) =>
      [r.event, r.event_name, r.single?.holder ?? '', r.single?.wca_id ?? '', r.average?.holder ?? '', r.average?.wca_id ?? '']
        .join(' ')
        .toLowerCase()
        .includes(q),
    )
  : all;

const byEvent: Record<string, RecordSnapshot[]> = {};
for (const s of snaps) {
  (byEvent[s.event] ??= []).push(s);
}
---

<Base title="National Records">
  <section class="container-x py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Bangladesh National Records</h1>
    <p class="mt-2 text-slate-600">
      Updated daily from the official WCA database export
      {recs.asOfExportDate ? <span class="data-font"> (v{recs.asOfExportDate})</span> : ''}
      . <a class="font-bold text-emerald-brand underline" href="https://www.worldcubeassociation.org/results/records" target="_blank" rel="noopener">Verify on WCA</a>
      {' '}<a class="btn-pill ml-2 inline-block border-2 border-ink bg-white px-4 py-1 text-sm shadow-brutal" href="/api/records.csv" download>CSV Export</a>
    </p>
    <form method="get" action="/records" class="mt-6 flex max-w-xl gap-2">
      <input
        name="q"
        type="search"
        value={Astro.url.searchParams.get('q') ?? ''}
        placeholder="Filter by event or holder…"
        maxlength="60"
        class="min-w-0 flex-1 rounded-lg border-2 border-ink px-3 py-2"
      />
      <button type="submit" class="btn-pill shrink-0 border-2 border-ink bg-white px-5 py-2 text-sm shadow-brutal">
        Filter
      </button>
      {q && (
        <a href="/records" class="shrink-0 self-center text-sm font-bold text-emerald-brand underline">
          Clear
        </a>
      )}
    </form>
    {
      records.length === 0 ? (
        <p class="mt-6 text-slate-600">
          {all.length === 0 ? 'Records sync daily — the table appears after the first sync.' : `No records match “${q}”.`}
        </p>
      ) : (
        <>
        <p class="data-font mt-3 text-xs text-slate-400 sm:hidden">Swipe sideways for more columns →</p>
        <div class="card-brutal mt-2 overflow-x-auto">
          <table class="w-full min-w-180 text-left text-sm">
            <thead>
              <tr class="border-b-2 border-ink">
                <th class="data-font px-4 py-2 text-xs uppercase tracking-wider text-slate-500">Event</th>
                <th class="data-font px-4 py-2 text-xs uppercase tracking-wider text-slate-500">Single</th>
                <th class="data-font px-4 py-2 text-xs uppercase tracking-wider text-slate-500">Average</th>
                <th class="data-font px-4 py-2 text-xs uppercase tracking-wider text-slate-500">History</th>
              </tr>
            </thead>
            <tbody>
              {records.map((r) => {
                const hist = (byEvent[r.event] ?? []).slice(0, 8);
                return (
                  <tr class="border-b border-slate-200 align-top last:border-0">
                    <td class="px-4 py-3 font-extrabold">
                      <span class="data-font mr-2 inline-block rounded-md border border-ink bg-cube-yellow px-1.5 py-0.5 text-xs">{r.event}</span>
                      {r.event_name}
                    </td>
                    <td class="px-4 py-3">
                      {r.single ? (
                        <>
                          <span class="data-font text-lg font-bold">{formatRecordValue(r.event, 'single', r.single.value_centis) ?? '—'}</span>
                          <span class="block text-xs text-slate-600">
                            {r.single.holder} • {r.single.wca_id}
                          </span>
                        </>
                      ) : (
                        '—'
                      )}
                    </td>
                    <td class="px-4 py-3">
                      {r.average ? (
                        <>
                          <span class="data-font text-lg font-bold">{formatRecordValue(r.event, 'average', r.average.value_centis) ?? '—'}</span>
                          <span class="block text-xs text-slate-600">
                            {r.average.holder} • {r.average.wca_id}
                          </span>
                        </>
                      ) : (
                        '—'
                      )}
                    </td>
                    <td class="data-font px-4 py-3 text-xs text-slate-600">
                      {hist.length < 2 ? (
                        'Accumulates with daily syncs'
                      ) : (
                        <ol>
                          {hist.map((h) => (
                            <li>
                              {h.export_date}: {formatRecordValue(h.event, h.kind as 'single' | 'average', h.value_centis) ?? 'see WCA'}
                            </li>
                          ))}
                        </ol>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        </>
      )
    }
  </section>
</Base>
