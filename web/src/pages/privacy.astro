---
import Base from '../layouts/Base.astro';
import ContentBody from '../components/ContentBody.astro';
import { getPage } from '../lib/content';
import { EDGE_CACHE_VALUE, tryLoad } from '../lib/page';

export const prerender = false;
Astro.response.headers.set('Cache-Control', EDGE_CACHE_VALUE);

// Privacy notice lives in D1 (page/privacy) like all content — never in repo.
// Until it is entered, show an honest pointer instead of a fabricated policy.
const notice = await tryLoad(Astro.locals, (env) => getPage(env, 'privacy'), null);
---

<Base title="Privacy notice">
  <section class="container-x max-w-3xl py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Privacy notice</h1>
    {notice ? (
      <div class="card-brutal mt-6 p-6">
        <div class="prose mt-3 max-w-none">
          <ContentBody docJson={notice.body_json} />
        </div>
      </div>
    ) : (
      <div class="card-brutal mt-6 p-6">
        <p class="text-sm text-slate-600">
          A complete privacy notice—including how submitted information is used, who can access it, and how long it is kept—is not published yet.
          Until it is finalized, provide only the information a form asks for and avoid sending passwords or other sensitive details.
          Questions or a privacy request? Use the <a class="font-bold text-emerald-brand underline" href="/contact">contact form</a>.
        </p>
      </div>
    )}
  </section>
</Base>
