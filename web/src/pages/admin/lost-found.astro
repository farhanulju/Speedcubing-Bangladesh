---
import AdminShell from '../../layouts/AdminShell.astro';
import { listLostFound, LOST_FOUND_STATUSES } from '../../lib/inbox';
import { getEnv } from '../../lib/bindings';

export const prerender = false;

const status = Astro.url.searchParams.get('status') ?? '';
let rows: Record<string, unknown>[] = [];
let dbError: string | null = null;
try {
  rows = await listLostFound(getEnv(Astro.locals), status || undefined);
} catch (err) {
  dbError = err instanceof Error ? err.message : 'database unavailable';
}
---

<AdminShell title="Lost & found inbox" current="lost-found">
  <section class="container-x py-10">
    <a href="/admin" class="text-sm font-semibold text-emerald-brand underline">← Admin</a>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight">Lost &amp; found inbox</h1>
    <p class="mt-2 max-w-2xl text-slate-600">
      Reporter contacts stay here — never publish them. The public log shows item + location + status only.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a href="/admin/lost-found" class={`btn-pill border-2 border-ink px-4 py-1 text-sm ${!status ? 'bg-ink text-white' : 'bg-white'}`}>All</a>
      {
        LOST_FOUND_STATUSES.map((s) => (
          <a
            href={`/admin/lost-found?status=${s}`}
            class={`btn-pill border-2 border-ink px-4 py-1 text-sm ${status === s ? 'bg-ink text-white' : 'bg-white'}`}
          >
            {s}
          </a>
        ))
      }
    </div>
    {
      dbError ? (
        <div class="card-brutal mt-6 p-6">
          <p class="font-bold">Database unavailable</p>
          <p class="data-font mt-1 text-sm text-slate-600">{dbError}</p>
        </div>
      ) : rows.length === 0 ? (
        <div class="card-brutal mt-6 p-6">
          <p class="font-bold">Inbox clear.</p>
        </div>
      ) : (
        <div class="mt-6 flex flex-col gap-3">
          {rows.map((r) => (
            <div class="card-brutal p-5" data-inbox-row={String(r.id)}>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <p class="font-extrabold">{String(r.item)}</p>
                <span class="data-font rounded-full border px-2 py-0.5 text-xs font-bold">{String(r.status)}</span>
              </div>
              <p class="data-font mt-1 text-xs text-slate-500">
                {String(r.comp_wca_id ?? '—')} • reported {String(r.created_at)} • contact on file (admin-only)
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <select data-status-select class="rounded-lg border-2 border-ink px-2 py-1 text-sm">
                  {LOST_FOUND_STATUSES.map((s) => (
                    <option value={s} selected={String(r.status) === s}>
                      {s}
                    </option>
                  ))}
                </select>
                <button data-status-save class="btn-pill border-2 border-ink bg-emerald-brand px-4 py-1 text-sm text-white">
                  Save
                </button>
                <span data-row-error class="hidden text-sm font-semibold text-red-700" />
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>
</AdminShell>

<script>
  document.querySelectorAll('[data-inbox-row]').forEach((rowEl) => {
    const row = rowEl as HTMLElement;
    const btn = row.querySelector('[data-status-save]');
    const select = row.querySelector('[data-status-select]');
    const errEl = row.querySelector('[data-row-error]');
    if (!(btn instanceof HTMLButtonElement) || !(select instanceof HTMLSelectElement) || !(errEl instanceof HTMLElement)) {
      return;
    }
    btn.addEventListener('click', async () => {
      errEl.classList.add('hidden');
      try {
        const res = await fetch('/api/admin/lost-found', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: row.dataset.inboxRow, status: select.value }),
        });
        const body = (await res.json()) as { error?: string };
        if (!res.ok) throw new Error(body.error || 'update failed');
        window.location.reload();
      } catch (err) {
        errEl.textContent = err instanceof Error ? err.message : 'update failed';
        errEl.classList.remove('hidden');
      }
    });
  });
</script>
