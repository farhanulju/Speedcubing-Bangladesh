---
import Base from '../layouts/Base.astro';
import ContentBody from '../components/ContentBody.astro';
import { getFaqs } from '../lib/content';
import { EDGE_CACHE_VALUE, tryLoad } from '../lib/page';

export const prerender = false;
Astro.response.headers.set('Cache-Control', EDGE_CACHE_VALUE);

const faqs = await tryLoad(Astro.locals, (env) => getFaqs(env), []);
---

<Base title="FAQ">
  <section class="container-x max-w-3xl py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Frequently Asked Questions</h1>
    <p class="mt-2 text-slate-600">First-timer guide, registration and payments, rules, and Worlds 2027.</p>
    {faqs.length > 0 && <input data-faq-filter type="search" placeholder="Filter questions…" class="mt-6 w-full rounded-lg border-2 border-ink px-3 py-2" aria-label="Filter questions" />}
    <div class="mt-4 flex flex-col gap-3">
      {
        faqs.length === 0 ? (
          <p class="text-slate-600">No questions have been published yet. Need help now? <a class="font-bold text-emerald-brand underline" href="/contact">Contact the team</a>.</p>
        ) : (
          faqs.map((f) => (
            <details data-faq-item class="card-brutal p-5" data-q={f.q.toLowerCase()}>
              <summary class="cursor-pointer font-extrabold">{f.q}</summary>
              <div class="prose mt-3 max-w-none text-sm">
                <ContentBody docJson={f.a_json} />
              </div>
            </details>
          ))
        )
      }
    </div>
  </section>
</Base>

<script>
  const input = document.querySelector('[data-faq-filter]') as HTMLInputElement | null;
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    document.querySelectorAll('[data-faq-item]').forEach((el) => {
      const item = el as HTMLElement;
      const text = item.dataset.q ?? '';
      item.style.display = !q || text.includes(q) ? '' : 'none';
    });
  });
</script>
