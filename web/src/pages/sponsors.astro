---
import Base from '../layouts/Base.astro';
import ContentBody from '../components/ContentBody.astro';
import { getPage, getSponsors } from '../lib/content';
import { EDGE_CACHE_VALUE, tryLoad } from '../lib/page';

export const prerender = false;
Astro.response.headers.set('Cache-Control', EDGE_CACHE_VALUE);

const pitch = await tryLoad(Astro.locals, (env) => getPage(env, 'sponsors-pitch'), null);
const sponsors = await tryLoad(Astro.locals, (env) => getSponsors(env), []);
---

<Base title="Sponsors">
  <section class="container-x py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Sponsors</h1>
    <p class="mt-2 max-w-2xl text-slate-600">
      Every taka funds venues, timing gear, and youth travel. Financial disclosures publish with the annual report.
    </p>
    {
      pitch && (
        <div class="card-brutal mt-6 max-w-3xl p-6">
          <div class="prose max-w-none">
            <ContentBody docJson={pitch.body_json} />
          </div>
        </div>
      )
    }
    <h2 class="mt-8 text-2xl font-extrabold">Partners</h2>
    {
      sponsors.length === 0 ? (
        <p class="mt-3 text-slate-600">Partner wall publishes here once sponsors are entered in /admin.</p>
      ) : (
        <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {sponsors.map((s) => (
            <div class="card-brutal p-5">
              {s.logo_r2 && <img src={`/api/media/${s.logo_r2}`} alt={`${s.name} logo`} loading="lazy" class="mb-3 h-12 object-contain" />}
              <p class="font-extrabold">{s.name}</p>
              <p class="data-font mt-1 text-xs uppercase tracking-wider text-slate-500">{s.tier ?? ''}</p>
            </div>
          ))}
        </div>
      )
    }
    <div class="mt-8">
      {/*
        Partnership deck: WP-51 uploads the PDF to R2 key `org/partnership-deck.pdf`.
        Until then this link 404s — do not point it at Drive.
      */}
      <a href="/api/media/org/partnership-deck.pdf" class="btn-pill inline-block border-2 border-ink bg-white px-6 py-2 shadow-brutal">
        Download Partnership Deck (PDF)
      </a>
    </div>
  </section>
</Base>
