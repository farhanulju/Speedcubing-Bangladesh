---
import Base from '../../layouts/Base.astro';
import { getEnv } from '../../lib/bindings';
import { getCompetitor, getConsent, getMyRegistrations } from '../../lib/registrations';
import { optionalUser } from '../../lib/session';
import { formatCenti, getRanks } from '../../lib/wca';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const session = await optionalUser(Astro.request, Astro.locals);
if (!session) return Astro.redirect('/api/auth/login');

const env = getEnv(Astro.locals);
const me = await getCompetitor(env, session.cid);
if (!me) return Astro.redirect('/api/auth/login');
const regs = await getMyRegistrations(env, session.cid);
const consent = await getConsent(env, session.cid);

// Personal bests + BD ranks from the ranks cache (dashboard-only scan; null when unknown).
let pbSingle: number | null = null;
let pbAverage: number | null = null;
let bdSingle: number | null = null;
let bdAverage: number | null = null;
if (me.wca_id) {
  const [s, a] = await Promise.all([getRanks(env, '333', 'single'), getRanks(env, '333', 'average')]);
  const rs = s.data?.items.find((r) => r.personId === me.wca_id);
  const ra = a.data?.items.find((r) => r.personId === me.wca_id);
  pbSingle = rs?.best ?? null;
  pbAverage = ra?.best ?? null;
  bdSingle = rs?.rank?.country ?? null;
  bdAverage = ra?.rank?.country ?? null;
}

const stepOf = (r: (typeof regs)[number], hasWcaId: boolean) => ({
  wca: hasWcaId,
  events: true as boolean,
  fee: r.status === 'verified' ? ('done' as const) : r.latest_tx ? ('pending' as const) : ('todo' as const),
  wcaAccepted: r.wca_accepted === 1,
});
---

<Base title="Dashboard" description="Your Speedcubing Bangladesh registrations, payment status, WCA profile summary, and consent records." robots="noindex, nofollow">
  <section class="container-x py-10">
    <div class="card-brutal shadow-brutal p-6">
      <h1 class="text-2xl font-extrabold">{me.name}</h1>
      <p class="data-font mt-1 text-sm text-slate-600">
        {me.wca_id ? (
          <a class="underline" href={`https://www.worldcubeassociation.org/persons/${me.wca_id}`} target="_blank" rel="noopener">
            WCA: {me.wca_id}
          </a>
        ) : (
          'No WCA ID yet — assigned after your first competition.'
        )}
      </p>
      <div class="mt-3 flex flex-wrap gap-4">
        <div>
          <p class="data-font text-xs uppercase tracking-wider text-slate-500">3x3 single PB</p>
          <p class="data-font text-xl font-bold">
            {pbSingle !== null ? formatCenti(pbSingle) : '—'}
            {bdSingle !== null && <span class="ml-2 text-xs font-bold text-emerald-brand">BD #{bdSingle}</span>}
          </p>
        </div>
        <div>
          <p class="data-font text-xs uppercase tracking-wider text-slate-500">3x3 average PB</p>
          <p class="data-font text-xl font-bold">
            {pbAverage !== null ? formatCenti(pbAverage) : '—'}
            {bdAverage !== null && <span class="ml-2 text-xs font-bold text-emerald-brand">BD #{bdAverage}</span>}
          </p>
        </div>
      </div>
      <p class="mt-3">
        <a href="/api/auth/logout" class="text-sm font-bold text-slate-600 underline">Log out</a>
      </p>
    </div>

    <h2 class="mt-8 text-2xl font-extrabold">Active registrations</h2>
    {
      regs.length === 0 ? (
        <p class="mt-3 text-slate-600">
          Nothing yet — pick a competition to register. <a class="font-bold text-emerald-brand underline" href="/competitions">Browse competitions</a>
        </p>
      ) : (
        <div class="mt-3 flex flex-col gap-4">
          {regs.map((r) => {
            const st = stepOf(r, me.wca_id !== null);
            const events: string[] = (() => {
              try {
                const v = JSON.parse(r.events_json);
                return Array.isArray(v) ? v.map(String) : [];
              } catch {
                return [];
              }
            })();
            return (
              <div class="card-brutal p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <p class="text-lg font-extrabold">{r.comp_name}</p>
                  <span class="data-font rounded-full border px-2 py-0.5 text-xs font-bold">{r.status}</span>
                </div>
                <ol class="mt-3 grid gap-2 text-sm sm:grid-cols-4">
                  <li>{st.wca ? '✅ WCA ID validated' : '⬜ No WCA ID yet'}</li>
                  <li>✅ {events.length} event{events.length === 1 ? '' : 's'} selected</li>
                  <li>
                    {st.fee === 'done' ? '✅ Fee verified' : st.fee === 'pending' ? '⏳ Payment under review' : '⬜ TxID not submitted'}
                  </li>
                  <li>{st.wcaAccepted ? '✅ Accepted on WCA' : '⬜ WCA acceptance pending'}</li>
                </ol>
                {r.latest_tx && (
                  <p class="data-font mt-2 text-xs text-slate-600">
                    Latest Tx: {r.latest_tx.txn_id} • ৳{r.latest_tx.amount_bdt} • {r.latest_tx.status}
                  </p>
                )}
                <p class="mt-2">
                  <a class="text-sm font-bold text-emerald-brand underline" href={`/dashboard/registrations/${r.id}/slip`}>
                    Registration slip (print)
                  </a>
                </p>
              </div>
            );
          })}
        </div>
      )
    }

    <h2 class="mt-8 text-2xl font-extrabold">Registration history on this site</h2>
    <p class="mt-1 text-sm text-slate-600">This list covers registrations submitted here. Your official WCA competition results and podium history are in your WCA profile.</p>
    {regs.length > 0 && (
      <>
      <p class="data-font mt-3 text-xs text-slate-400 sm:hidden">Swipe sideways for more columns →</p>
      <div class="card-brutal mt-1 overflow-x-auto">
        <table class="w-full min-w-150 text-left text-sm">
          <thead>
            <tr class="border-b-2 border-ink">
              <th class="data-font px-4 py-2 text-xs uppercase tracking-wider text-slate-500">Competition</th>
              <th class="data-font px-4 py-2 text-xs uppercase tracking-wider text-slate-500">Fee</th>
              <th class="data-font px-4 py-2 text-xs uppercase tracking-wider text-slate-500">Roster</th>
            </tr>
          </thead>
          <tbody>
            {regs.map((r) => (
              <tr class="border-b border-slate-200 last:border-0">
                <td class="px-4 py-2 font-bold">{r.comp_name}</td>
                <td class="data-font px-4 py-2">{r.status === 'verified' ? `✅ ৳${r.latest_tx?.amount_bdt ?? ''}` : (r.latest_tx ? `⏳ ৳${r.latest_tx.amount_bdt}` : '—')}</td>
                <td class="data-font px-4 py-2">{r.wca_accepted === 1 ? '✅ Accepted' : 'Pending'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      </>
    )}
    <p class="mt-2">
      {me.wca_id ? (
        <a class="btn-pill inline-block border-2 border-ink bg-white px-5 py-2 text-sm shadow-brutal" href={`https://www.worldcubeassociation.org/persons/${me.wca_id}`} target="_blank" rel="noopener">
          Open official WCA competition history ↗
        </a>
      ) : (
        <span class="text-sm text-slate-600">Your history appears here after your first competition.</span>
      )}
    </p>

    <h2 class="mt-8 text-2xl font-extrabold">Guardian consent <span class="text-base font-semibold text-slate-500">(under-18 competitors only)</span></h2>
    {
      consent ? (
        <div class="card-brutal mt-3 p-5">
          <p class="text-sm">
            Consent on file — {consent.guardian_name} ({consent.relation}), {consent.consent_at}
            {consent.verified_by ? `, verified by ${consent.verified_by}` : ''}.
          </p>
        </div>
      ) : (
        <details class="card-brutal mt-3 max-w-xl p-5">
          <summary class="cursor-pointer list-none font-extrabold text-emerald-brand underline [&::-webkit-details-marker]:hidden">
            Record consent for an under-18 competitor
          </summary>
          <p class="mt-2 text-sm text-slate-600">If you are 18 or older, no action is needed. Otherwise, ask your parent or legal guardian to complete this section.</p>
          <form data-consent-form class="mt-4 flex flex-col gap-3">
            <label class="flex flex-col gap-1">
              <span class="text-sm font-bold">Guardian name *</span>
              <input name="guardian_name" type="text" required maxlength="120" autocomplete="name" class="rounded-lg border-2 border-ink px-3 py-2" />
            </label>
            <label class="flex flex-col gap-1">
              <span class="text-sm font-bold">Relationship *</span>
              <input name="relation" type="text" required maxlength="40" placeholder="Parent or legal guardian" class="rounded-lg border-2 border-ink px-3 py-2" />
            </label>
            <label class="flex items-start gap-2 text-sm font-bold">
              <input name="agree" type="checkbox" required class="mt-0.5 h-5 w-5 shrink-0 accent-emerald-brand" /> I am this competitor's parent or legal guardian and I consent to their participation record being held for competition administration.
            </label>
            <p data-form-msg class="hidden text-sm font-semibold"></p>
            <button type="submit" class="btn-pill w-fit border-2 border-ink bg-emerald-brand px-6 py-2 text-white shadow-brutal">
              Record guardian consent
            </button>
          </form>
        </details>
      )
    }
  </section>
</Base>

<script>
  document.querySelectorAll('[data-consent-form]').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector('[data-form-msg]') as HTMLElement;
      msg.classList.remove('hidden');
      try {
        const data = new FormData(form);
        const res = await fetch('/api/consent', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            guardian_name: String(data.get('guardian_name') ?? ''),
            relation: String(data.get('relation') ?? ''),
            agree: (form.querySelector('[name="agree"]') as HTMLInputElement).checked,
          }),
        });
        const body = (await res.json()) as { error?: string };
        if (!res.ok) throw new Error(body.error || 'save failed');
        window.location.reload();
      } catch (err) {
        msg.textContent = err instanceof Error ? err.message : 'save failed';
        msg.classList.add('text-red-700');
      }
    });
  });
</script>
