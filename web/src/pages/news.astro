---
import Base from '../layouts/Base.astro';
import { getNews } from '../lib/content';
import { EDGE_CACHE_VALUE, tryLoad } from '../lib/page';

export const prerender = false;
Astro.response.headers.set('Cache-Control', EDGE_CACHE_VALUE);

const news = await tryLoad(Astro.locals, (env) => getNews(env, 20), []);
---

<Base title="News">
  <section class="container-x py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">News &amp; Community Stories</h1>
    <p class="mt-2 text-slate-600">Competition recaps, record breakthroughs, and the road to Worlds 2027.</p>
    {
      news.length === 0 ? (
        <p class="mt-6 text-slate-600">Stories publish here once the media team enters them in /admin.</p>
      ) : (
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {news.map((n) => (
            <a href={`/news/${n.slug}`} class="card-brutal shadow-brutal block p-5 hover:-translate-y-0.5">
              {n.cover_r2 && (
                <img src={`/api/media/${n.cover_r2}`} alt="" loading="lazy" class="mb-3 aspect-video w-full rounded-lg border-2 border-ink object-cover" />
              )}
              <p class="font-extrabold">{n.title}</p>
              <p class="data-font mt-1 text-xs text-slate-500">{n.published_at ?? ''}</p>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Base>
