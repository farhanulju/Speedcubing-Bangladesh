---
import Base from '../layouts/Base.astro';
import ContentBody from '../components/ContentBody.astro';
import { getDonationPage, getDonors, getPage } from '../lib/content';
import { EDGE_CACHE_VALUE, tryLoad } from '../lib/page';

export const prerender = false;
Astro.response.headers.set('Cache-Control', EDGE_CACHE_VALUE);

const donation = await tryLoad(Astro.locals, (env) => getDonationPage(env), null);
const donors = await tryLoad(Astro.locals, (env) => getDonors(env), []);
const story = await tryLoad(Astro.locals, (env) => getPage(env, 'worlds-story'), null);
const criteria = await tryLoad(Astro.locals, (env) => getPage(env, 'worlds-criteria'), null);
const pct =
  donation && donation.target_bdt > 0 ? Math.min(100, Math.round((donation.raised_manual_bdt / donation.target_bdt) * 100)) : 0;
function maskWallet(w: string): string {
  const s = w.trim();
  if (s.length <= 5) return '•••••';
  return `${s.slice(0, 3)}••••${s.slice(-2)}`;
}
---

<Base title="Worlds 2027">
  <section class="container-x py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Bangladesh to WCA World Championship 2027</h1>
    {
      story ? (
        <div class="prose mt-4 max-w-3xl">
          <ContentBody docJson={story.body_json} />
        </div>
      ) : (
        <p class="mt-4 max-w-3xl text-slate-600">
          Campaign details, candidate criteria, refund terms, and verified fundraising progress will be published here once confirmed.
        </p>
      )
    }
    {
      donation && (
        <div class="card-brutal shadow-brutal mt-8 max-w-3xl bg-electric-violet p-6 text-white">
          <p class="data-font text-sm">
            Raised ৳{donation.raised_manual_bdt} of ৳{donation.target_bdt} ({pct}%) — updated as donations are verified
          </p>
          <div class="mt-2 h-3 overflow-hidden rounded-full border border-white/40 bg-black/30">
            <div class="h-full bg-cube-yellow" style={`width:${pct}%`} />
          </div>
          {donation.bkash_wallet && (
            <details class="data-font mt-3 text-sm">
              <summary class="cursor-pointer underline">bKash: {maskWallet(donation.bkash_wallet)} — Reveal</summary>
              <p class="mt-1">{donation.bkash_wallet}</p>
            </details>
          )}
          {donation.nagad_wallet && (
            <details class="data-font mt-1 text-sm">
              <summary class="cursor-pointer underline">Nagad: {maskWallet(donation.nagad_wallet)} — Reveal</summary>
              <p class="mt-1">{donation.nagad_wallet}</p>
            </details>
          )}
        </div>
      )
    }
    {
      criteria && (
        <div class="card-brutal mt-8 max-w-3xl p-6">
          <h2 class="text-2xl font-extrabold">Candidate criteria &amp; refund policy</h2>
          <div class="prose mt-3 max-w-none">
            <ContentBody docJson={criteria.body_json} />
          </div>
        </div>
      )
    }
    {
      donors.length > 0 && (
        <div class="mt-8 max-w-3xl">
          <h2 class="text-2xl font-extrabold">Community backers</h2>
          <p class="mt-1 text-sm text-slate-600">Opt-in names only. Anonymous donors stay anonymous.</p>
          <div class="mt-3 flex flex-col gap-2">
            {donors.map((d) => (
              <div class="card-brutal flex items-baseline justify-between p-4">
                <p class="font-bold">{d.name}</p>
                {d.amount_bdt !== null && <p class="data-font">৳{d.amount_bdt}</p>}
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>
</Base>
