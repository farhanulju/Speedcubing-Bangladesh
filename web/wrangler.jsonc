{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/",
  "name": "speedbd-web",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speedbd",
      "database_id": "REPLACE_WITH_D1_ID__see_plan_OPS_HANDOFF_md",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WCA_CACHE",
      "id": "REPLACE_WITH_KV_ID__see_plan_OPS_HANDOFF_md"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "speedbd-media"
    }
  ]
}
