{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/",
  "name": "speedbd-web",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speedbd",
      "database_id": "53805520-bdb1-474a-aab5-e4368118a5a5",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WCA_CACHE",
      "id": "082f9d45da744e2a8f2a6825045e4bf8",
      "preview_id": "5bc0cca379b04480b0bc5b82aa6237f5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "speedbd-media"
    }
  ]
}
