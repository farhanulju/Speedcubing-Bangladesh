{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/",
  // NOTE: local D1/KV state is per config file (./workers/sync/.wrangler),
  // separate from the web app's ./.wrangler. Run migrations for BOTH locally:
  //   npm run db:migrate && npx wrangler d1 migrations apply speedbd --local -c workers/sync/wrangler.jsonc
  // Production shares one remote DB by ID, so this is dev-only divergence.
  "name": "speedbd-sync",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "triggers": {
    "crons": ["0 20 * * *", "*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speedbd",
      "database_id": "REPLACE_WITH_D1_ID__see_plan_OPS_HANDOFF_md",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WCA_CACHE",
      "id": "REPLACE_WITH_KV_ID__see_plan_OPS_HANDOFF_md"
    }
  ]
}
